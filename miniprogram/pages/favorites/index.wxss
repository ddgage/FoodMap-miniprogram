/* pages/favorites/index.wxss */
.page-container {
  min-height: 100vh;
  background: #f6f6f6;
  padding-bottom: 120rpx;
}

/* 卡片 */
.post-list {
  padding: 16rpx 0;
}

.post-card-wrap {
  position: relative;
  display: flex;
  align-items: center;
  margin: 0 24rpx 16rpx;
  border-radius: 16rpx;
  background: #fff;
}

.post-card {
  flex: 1;
  display: flex;
  padding: 20rpx;
  gap: 20rpx;
  background: #fff;
  border-radius: 16rpx;
}

.card-cover {
  width: 180rpx;
  height: 130rpx;
  border-radius: 12rpx;
  background: #f0f0f0;
  flex-shrink: 0;
}

.card-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.card-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.card-meta {
  display: flex;
  gap: 20rpx;
  font-size: 24rpx;
  color: #999;
}

/* 长按删除按钮 */
.delete-btn {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: #ff4d4f;
  color: #fff;
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 77, 79, 0.35);
  z-index: 10;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
  color: #999;
  font-size: 28rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #ccc;
  margin-top: 8rpx;
}

/* 加载 */
.load-more {
  display: flex;
  justify-content: center;
  padding: 30rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #eee;
  border-top-color: #07C160;
  border-radius: 50%;
  animation: spin 0.6s linear infinite;
}

.no-more {
  font-size: 24rpx;
  color: #ccc;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
