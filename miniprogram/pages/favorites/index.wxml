<!--pages/favorites/index.wxml-->
<view class="page-container">
  <!-- 收藏列表 -->
  <view class="post-list" wx:if="{{posts.length > 0}}" catchtap="onTapOutside">
    <view class="post-card-wrap" wx:for="{{posts}}" wx:key="_id" data-index="{{index}}"
          bindlongpress="onLongPress">
      <view class="post-card" bindtap="onPostTap" data-id="{{item._id}}">
        <image class="card-cover" src="{{item.cover_image || '/images/default-goods-image.png'}}" mode="aspectFill"></image>
        <view class="card-info">
          <view class="card-title">{{item.title}}</view>
          <view class="card-meta">
            <text wx:if="{{item.author_name}}">{{item.author_name}}</text>
            <text>{{item.view_count || 0}} 浏览</text>
            <text>{{item.fav_count || 0}} 收藏</text>
          </view>
        </view>
      </view>
      <!-- 长按露出的删除按钮 -->
      <view class="delete-btn" wx:if="{{showDeleteIndex === index}}" catchtap="onDeleteFav" data-index="{{index}}">
        <text>删除</text>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{posts.length === 0 && !loading}}">
    <text class="empty-icon">❤️</text>
    <text>暂无收藏</text>
    <text class="empty-sub">去探店页发现精彩内容吧</text>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
  </view>
  <view class="load-more" wx:if="{{!hasMore && posts.length > 0}}">
    <text class="no-more">— 没有更多了 —</text>
  </view>
</view>
