/* pages/city-picker/index.wxss */
.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #fff;
}

/* 搜索框 */
.search-wrap {
  padding: 16rpx 24rpx;
  background: #fff;
}

.search-input-box {
  display: flex;
  align-items: center;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 24rpx;
  gap: 12rpx;
}

.search-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.search-field {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.search-clear {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #ccc;
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 搜索结果 */
.search-result {
  flex: 1;
  overflow-y: auto;
}

.result-empty {
  text-align: center;
  padding: 120rpx 0;
  color: #999;
  font-size: 28rpx;
}

.result-item {
  padding: 28rpx 32rpx;
  font-size: 30rpx;
  color: #333;
  border-bottom: 1rpx solid #f5f5f5;
}

.result-item:active {
  background: #f5f5f5;
}

/* 当前定位 */
.current-city {
  padding: 24rpx 32rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
}

.current-label {
  font-size: 24rpx;
  color: #999;
}

.current-name {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 10rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.reload-icon {
  font-size: 28rpx;
  color: #07C160;
  padding: 8rpx 16rpx;
}

/* 热门城市 */
.section {
  padding: 0 32rpx;
}

.section-title {
  font-size: 24rpx;
  color: #999;
  padding: 20rpx 0 12rpx;
}

.hot-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding-bottom: 16rpx;
}

.hot-item {
  padding: 12rpx 28rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #333;
}

.hot-item:active {
  background: #e0e0e0;
}

/* 城市滚动列表 */
.city-list-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

.city-scroll {
  width: 100%;
}

.letter-title {
  padding: 12rpx 32rpx;
  font-size: 24rpx;
  color: #999;
  background: #f6f6f6;
}

.city-item {
  padding: 28rpx 32rpx;
  font-size: 30rpx;
  color: #333;
  border-bottom: 1rpx solid #f5f5f5;
}

.city-item:active {
  background: #f5f5f5;
}

/* 右侧字母索引条 */
.letter-bar {
  position: fixed;
  right: 8rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 2rpx;
  z-index: 100;
  padding: 8rpx 0;
}

.letter-dot {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #666;
  border-radius: 50%;
}

.letter-dot.active {
  color: #fff;
  background: #07C160;
  font-weight: 700;
}
