<!--pages/shop-detail/index.wxml-->
<view class="page-container">
  <!-- 店铺图片轮播 -->
  <swiper class="photo-swiper" indicator-dots="{{photos.length > 1}}" autoplay circular>
    <swiper-item wx:for="{{photos}}" wx:key="*this">
      <image class="swiper-img" src="{{item}}" mode="aspectFill"></image>
    </swiper-item>
    <swiper-item wx:if="{{photos.length === 0}}">
      <image class="swiper-img" src="/images/default-goods-image.png" mode="aspectFill"></image>
    </swiper-item>
  </swiper>

  <!-- 店铺基本信息 -->
  <view class="info-card">
    <view class="shop-name">{{shop.name}}</view>
    <view class="shop-meta">
      <text wx:if="{{shop.rating}}" class="rating">⭐ {{shop.rating}}</text>
      <text wx:if="{{shop.category}}" class="category">{{shop.category}}</text>
      <text wx:if="{{shop.avg_price}}" class="price">人均 ¥{{shop.avg_price}}</text>
    </view>
    <view class="shop-address" wx:if="{{shop.address}}">
      <text>📍 {{shop.address}}</text>
    </view>
    <view class="shop-phone" wx:if="{{shop.phone}}">
      <text>📞 {{shop.phone}}</text>
    </view>
  </view>

  <!-- 地图预览 -->
  <view class="map-preview" wx:if="{{shop.location}}" bindtap="onMapNav">
    <map
      class="mini-map"
      latitude="{{shop.location.lat || shop.location.latitude}}"
      longitude="{{shop.location.lng || shop.location.longitude}}"
      markers="{{[previewMarker]}}"
      show-location="{{false}}"
      enable-zoom="{{false}}"
      enable-scroll="{{false}}"
    ></map>
    <view class="map-overlay">
      <text>点击查看地图导航</text>
    </view>
  </view>

  <!-- 操作按钮 -->
  <view class="action-buttons">
    <button class="btn-nav" bindtap="onMapNav" wx:if="{{shop.location}}">
      🧭 跳转地图导航
    </button>
    <button class="btn-meituan" bindtap="onMeituanTap" wx:if="{{shop.meituan_url}}">
      🛒 查看美团团购
    </button>
  </view>

  <!-- Loading -->
  <view class="loading-mask" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
  </view>
</view>
