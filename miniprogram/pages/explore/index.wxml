<!--pages/explore/index.wxml-->
<view class="page-container">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input" bindtap="onSearchTap">
      <image class="search-icon" src="/images/icons/search.svg" mode="aspectFit"></image>
      <text class="search-placeholder">搜索探店笔记标题、地点</text>
    </view>
  </view>

  <!-- 筛选栏 -->
  <view class="filter-bar">
    <view class="filter-item {{currentSort === 'latest' ? 'active' : ''}}" data-sort="latest" bindtap="onSortTap">
      最新发布
    </view>
    <view class="filter-item {{currentSort === 'popular' ? 'active' : ''}}" data-sort="popular" bindtap="onSortTap">
      最多收藏
    </view>
    <view class="filter-item {{currentSort === 'views' ? 'active' : ''}}" data-sort="views" bindtap="onSortTap">
      最多浏览
    </view>
  </view>

  <!-- 分类快速筛选 -->
  <scroll-view class="category-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
    <view class="cate-chip {{currentCategory === item.name ? 'active' : ''}}"
          wx:for="{{categories}}" wx:key="_id"
          data-category="{{item.name}}"
          bindtap="onCategoryTap">
      {{item.name}}
    </view>
  </scroll-view>

  <!-- 双列瀑布流 -->
  <view class="waterfall" wx:if="{{postList.length > 0}}">
    <view class="waterfall-col">
      <view class="post-card" wx:for="{{leftList}}" wx:key="_id"
            data-id="{{item._id}}" bindtap="onPostTap">
        <image class="post-cover" src="{{item.cover_image || '/images/default-goods-image.png'}}" mode="widthFix"></image>
        <view class="post-title">{{item.title}}</view>
        <view class="post-meta">
          <text class="post-author">{{item.author_name}}</text>
          <text class="post-views">{{item.view_count || 0}} 浏览</text>
        </view>
      </view>
    </view>
    <view class="waterfall-col">
      <view class="post-card" wx:for="{{rightList}}" wx:key="_id"
            data-id="{{item._id}}" bindtap="onPostTap">
        <image class="post-cover" src="{{item.cover_image || '/images/default-goods-image.png'}}" mode="widthFix"></image>
        <view class="post-title">{{item.title}}</view>
        <view class="post-meta">
          <text class="post-author">{{item.author_name}}</text>
          <text class="post-views">{{item.view_count || 0}} 浏览</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view class="empty-state" wx:if="{{postList.length === 0 && !loading}}">
    <text>暂无探店笔记</text>
    <text class="empty-sub">敬请期待更多精彩内容</text>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{loading}}">
    <view class="loading-spinner"></view>
  </view>
  <view class="load-more" wx:if="{{!hasMore && postList.length > 0}}">
    <text class="no-more">— 没有更多了 —</text>
  </view>
</view>
