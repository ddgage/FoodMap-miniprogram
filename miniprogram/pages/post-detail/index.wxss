/* pages/post-detail/index.wxss */
.page-container {
  min-height: 100vh;
  background: #f6f6f6;
  padding-bottom: 120rpx;
}

/* 视频封面 */
.video-cover-wrap {
  width: 100vw;
  position: relative;
  background: #000;
}

.video-cover-wrap.no-cover {
  background: #f0f0f0;
}

.video-cover {
  width: 100%;
  display: block;
}

.play-btn {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 100rpx;
  height: 100rpx;
  background: rgba(0,0,0,0.5);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.play-icon {
  width: 0;
  height: 0;
  border-top: 20rpx solid transparent;
  border-bottom: 20rpx solid transparent;
  border-left: 34rpx solid #fff;
  margin-left: 8rpx;
}

/* 笔记信息 */
.post-info {
  background: #fff;
  padding: 24rpx 32rpx;
  margin-bottom: 16rpx;
}

.post-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #333;
  line-height: 1.4;
  margin-bottom: 16rpx;
}

.post-stats {
  display: flex;
  gap: 32rpx;
  font-size: 26rpx;
  color: #999;
}

/* 作者信息 */
.author-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: #fff;
  padding: 24rpx 32rpx;
  margin-bottom: 16rpx;
}

.author-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f0f0f0;
}

.author-info {
  flex: 1;
}

.author-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.author-label {
  font-size: 24rpx;
  color: #07C160;
  margin-top: 4rpx;
}

/* 文字描述 */
.content-card {
  background: #fff;
  padding: 24rpx 32rpx;
  margin-bottom: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

.content-text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.8;
}

/* 标签 */
.tags-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 32rpx 24rpx;
  background: #fff;
  margin-bottom: 16rpx;
}

.tag-item {
  padding: 6rpx 20rpx;
  font-size: 24rpx;
  color: #07C160;
  background: #e8f8ee;
  border-radius: 24rpx;
}

/* 关联店铺 */
.shop-card {
  background: #fff;
  padding: 24rpx 32rpx;
  margin-bottom: 16rpx;
}

.shop-info-card {
  border: 1rpx solid #eee;
  border-radius: 16rpx;
  padding: 24rpx;
}

.shop-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.shop-meta {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.shop-address {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 20rpx;
}

.shop-actions {
  display: flex;
  gap: 20rpx;
}

.btn-shop-nav, .btn-shop-meituan {
  flex: 1;
  height: 72rpx;
  border-radius: 36rpx;
  font-size: 26rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn-shop-nav {
  background: #07C160;
  color: #fff;
}

.btn-shop-meituan {
  background: #FFD100;
  color: #333;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: #fff;
  display: flex;
  border-top: 1rpx solid #eee;
  z-index: 100;
}

.bottom-action {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
}

.bottom-action.favorited {
  color: #e54545;
}

.btn-share {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #666;
  background: #fff;
  border: none;
  border-left: 1rpx solid #eee;
  border-radius: 0;
}

/* Loading */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255,255,255,0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #eee;
  border-top-color: #07C160;
  border-radius: 50%;
  animation: spin 0.6s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}
